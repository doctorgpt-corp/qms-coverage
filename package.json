{
  "name": "@aletta/qms-coverage",
  "version": "0.4.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./jest": {
      "types": "./dist/jest/index.d.ts",
      "require": "./dist/cjs/jest/index.js",
      "import": "./dist/jest/index.js"
    },
    "./jest/reporter": {
      "types": "./dist/jest/reporter.d.ts",
      "require": "./dist/cjs/jest/reporter.js",
      "import": "./dist/jest/reporter.js"
    }
  },
  "bin": {
    "qms-coverage-publish": "dist/bin/publish.js"
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/doctorgpt-corp/qms-coverage.git"
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc && bunx tsc --project tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "jest": ">=29",
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "jest": { "optional": true },
    "vitest": { "optional": true }
  },
  "devDependencies": {
    "@jest/test-result": "^29.7.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.5"
  }
}
